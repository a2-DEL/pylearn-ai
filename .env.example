# PyLearn AI 部署环境模板
# 复制为 .env 后按需修改：cp .env.example .env

# ---- 安全（生产务必修改） ----
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
AES_KEY=
# 前端地址（CORS），多域名用逗号分隔；开发可留 *
CORS_ORIGINS=*

# ---- 数据库 ----
# 默认 SQLite（零依赖一键启动）
DATABASE_URL=sqlite+aiosqlite:////app/pylearn.db
# 启用 PostgreSQL 时改为（需 docker compose --profile pg）：
# DATABASE_URL=postgresql+asyncpg://pylearn:pylearn@postgres:5432/pylearn

# ---- 集中限流（推荐生产配置） ----
# 容器网络内 Redis 地址；本机直接运行时可填 redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ---- 沙箱 ----
# local(本地兜底) / docker(容器，需挂载 docker.sock)
SANDBOX_BACKEND=local
SANDBOX_TIMEOUT=10
SANDBOX_MAX_OUTPUT=10000

# ---- PostgreSQL（仅 --profile pg 使用） ----
POSTGRES_USER=pylearn
POSTGRES_PASSWORD=pylearn
POSTGRES_DB=pylearn

# ---- Grafana（仅 --profile monitor 使用） ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
