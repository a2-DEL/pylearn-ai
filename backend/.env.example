# PyLearn AI 后端配置样例（复制为 .env 后按需修改）
# 数据库：默认 SQLite；切换 PostgreSQL 示例见下
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pylearn
DATABASE_URL=sqlite+aiosqlite:///./pylearn.db

# 安全：生产环境务必修改为随机强值
SECRET_KEY=change-me-in-production
AES_KEY=

# 前端 AES 盐（保持与前端一致即可，仅用于本地存储加密）
FRONTEND_AES_SALT=pylearn-ai-salt

# CORS：生产环境改为前端域名，逗号分隔
CORS_ORIGINS=*

# 沙箱：local(本地兜底) / docker(容器)
SANDBOX_BACKEND=local
SANDBOX_TIMEOUT=10
SANDBOX_MAX_OUTPUT=10000

# AI 限流
AI_RATE_PER_MIN=20
AI_RATE_PER_DAY=200

# 调试
DEBUG=false
