{
  "title": "PyLearn AI 概览",
  "uid": "pylearn-overview",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "请求总量",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "pylearn_requests_total", "legendFormat": "总请求" }
      ]
    },
    {
      "id": 2,
      "title": "5xx 错误数",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "pylearn_errors_total", "legendFormat": "错误" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }
      }
    },
    {
      "id": 3,
      "title": "限流触发次数",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "pylearn_ratelimit_total", "legendFormat": "限流" }
      ]
    },
    {
      "id": 4,
      "title": "平均 / 最大响应耗时 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "pylearn_latency_avg_ms", "legendFormat": "平均" },
        { "expr": "pylearn_latency_max_ms", "legendFormat": "最大" }
      ]
    },
    {
      "id": 5,
      "title": "请求速率 (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "rate(pylearn_requests_total[1m])", "legendFormat": "QPS" }
      ]
    },
    {
      "id": 6,
      "title": "错误率 (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "(rate(pylearn_errors_total[5m]) / (rate(pylearn_requests_total[5m]) > 0)) * 100", "legendFormat": "5xx 比率" }
      ]
    }
  ]
}
